# pnpm configuration.
#
# React Native / Expo require a flat (hoisted) node_modules: the default pnpm
# isolated linker breaks Metro resolution and native module autolinking.
node-linker=hoisted

# React Native's ecosystem ships many loose peer ranges; don't fail the install
# over them (this is pnpm's default, stated here for clarity).
strict-peer-dependencies=false

# Speed/robustness in CI.
prefer-frozen-lockfile=true
