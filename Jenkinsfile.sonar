// Analyze after successful CI so coverage is available for the same commit.
// Manual builds and cache misses still generate coverage locally.
pipeline {
  agent none
  parameters { string(name: 'NOTE', defaultValue: '', description: 'Optional run note') }
  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    lock('animu-build-host')
    skipDefaultCheckout(true)
  }
  triggers { upstream(upstreamProjects: 'Animu/animu-mobile-app', threshold: hudson.model.Result.SUCCESS) }
  environment {
    CI = 'true'
    JENKINS_USER = 'rmotafreitas'
  }
  stages {
    stage('SonarQube analysis') {
      agent { label 'animu-android-native' }
      steps {
        checkout scm
        withCredentials([string(credentialsId: 'jenkins-api-token', variable: 'JENKINS_API_TOKEN')]) {
          sh ''' 
              set -eu
              . scripts/ci-cache.sh
              bash scripts/init-submodules.sh
              corepack enable
              rm -rf coverage junit.xml
              # Retain dependencies for TypeScript analysis, but skip postinstall
              # builds: coverage and compiled packages come from validated CI.
              pnpm install --frozen-lockfile --ignore-scripts
              if ! node scripts/ci-results.mjs restore RadioAnimu/animu-mobile-app; then
                node scripts/prepare-submodules.mjs
                CI=true pnpm run test:coverage
              fi
              test -s coverage/lcov.info
              TOKEN_FILE="$HOME/sonarqube/analysis-token"
              test -f "$TOKEN_FILE"
              mkdir -p "$CI_CACHE_DIR/sonar"
              export SONAR_TOKEN="$(cat "$TOKEN_FILE")"
              docker run --rm --network host \
                -v "$WORKSPACE:/usr/src" -w /usr/src \
                -v "$CI_CACHE_DIR/sonar:/opt/sonar-scanner/.sonar" \
                -e SONAR_TOKEN -e SONAR_USER_HOME=/opt/sonar-scanner/.sonar \
                sonarsource/sonar-scanner-cli \
                -Dsonar.host.url=http://localhost:9001 \
                -Dsonar.qualitygate.wait=true
          '''
        }
      }
    }
  }
  post {
    success { echo 'SonarQube quality gate passed.' }
    failure { echo 'SonarQube quality gate failed.' }
  }
}
