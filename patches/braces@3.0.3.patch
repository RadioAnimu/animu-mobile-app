diff --git a/lib/validate-depth.js b/lib/validate-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..0b296ff43688428a70d1c304eaa5ef74d8e5941d
--- /dev/null
+++ b/lib/validate-depth.js
@@ -0,0 +1,25 @@
+'use strict';
+
+// Bound recursion before the legacy AST walkers run, including direct AST input.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const seen = new Set();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth >= 128 || seen.has(node)) {
+      throw new SyntaxError('Brace nesting exceeds limit of 128 or contains a cycle');
+    }
+    seen.add(node);
+    let parent = node.parent;
+    for (let levels = 0; parent; levels++) {
+      if (levels >= 128 || parent === node) {
+        throw new SyntaxError('Brace parent chain exceeds limit of 128 or contains a cycle');
+      }
+      parent = parent.parent;
+    }
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
