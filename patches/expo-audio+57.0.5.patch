+private fun estimateOutputLatencySeconds(context: Context): Double {
+  val audioManager = context.getSystemService(Context.AUDIO_SERVICE) as? AudioManager
+    ?: return 0.15
+  val framesPerBuffer = audioManager
+    .getProperty(AudioManager.PROPERTY_OUTPUT_FRAMES_PER_BUFFER)?.toDoubleOrNull() ?: 0.0
+  val outputSampleRate = audioManager
+    .getProperty(AudioManager.PROPERTY_OUTPUT_SAMPLE_RATE)?.toDoubleOrNull() ?: 0.0
