+  context: Context,
+  sink: SamplingAudioBufferSink
+): RenderersFactory {
+  val tee = TeeAudioProcessor(sink)
+  // PATCH: rough output-latency fallback (~3 hardware buffers) used until the
+  // sink's own playback head starts reporting a timestamp.
+  sink.fallbackLatencySeconds = estimateOutputLatencySeconds(context)
