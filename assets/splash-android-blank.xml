<?xml version="1.0" encoding="utf-8"?>
<!--
  Blank Android 12+ splash icon: the native splash shows only the #270051
  background, then the JS splash fades in the full-bleed artwork (Android's
  system splash can only render a small centered icon, which looks tiny for
  this portrait art).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <size android:width="1dp" android:height="1dp" />
</shape>
