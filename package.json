{
  "name": "animu",
  "version": "3.0.0",
  "author": "Ness.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "patch-package",
    "install:apk": "adb uninstall com.nessjs.animu; adb install $(ls -t dist/*.apk 2>/dev/null | head -1)",
    "lint": "expo lint",
    "build:api": "pnpm --dir packages/animu-api run build",
    "fonts": "node scripts/fetch-fonts.mjs",
    "eas-build-pre-install": "node scripts/fetch-fonts.mjs",
    "splash": "node scripts/generate-splash.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/material-icons": "^13.1.4",
    "@react-navigation/drawer": "^7.13.10",
    "@react-navigation/native": "^7.3.18",
    "animu-api": "file:packages/animu-api",
    "expo": "~57.0.25",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "57.0.5",
    "expo-auth-session": "~57.0.13",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~58.0.7",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-freeze": "^1.0.4",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-playback-controls": "0.2.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@napi-rs/canvas": "^1.0.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "jsdom": "^30.1.0",
    "patch-package": "^8.0.1",
    "react-doctor": "^0.9.14",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "react-native-webview",
        "expo-audio"
      ]
    },
    "autolinking": {
      "buildFromSource": [
        "expo-audio"
      ]
    }
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1"
    }
  }
}
