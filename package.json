{
  "name": "animu",
  "version": "3.0.0",
  "author": "Ness.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "WEB_RELATIVE_PATHS=1 expo export --platform web --output-dir dist/web",
    "install:apk": "node scripts/install-apk.mjs",
    "lint": "pnpm run lint:eslint && pnpm run lint:types && pnpm run lint:deps",
    "lint:eslint": "expo lint . -- --max-warnings 0",
    "lint:types": "oxlint --type-aware --deny-warnings",
    "lint:deps": "knip --no-progress && sherif -r root-package-dependencies -p animu-api",
    "typecheck": "tsc --noEmit",
    "check:expo-deps": "expo install --check",
    "check:expo-doctor": "expo-doctor",
    "check:audit": "node scripts/check-dependency-audit.mjs",
    "check:animu-api": "node scripts/check-submodule.mjs animu-api",
    "check:player": "node scripts/check-submodule.mjs react-native-anything-player",
    "build:api": "node scripts/prepare-submodules.mjs animu-api",
    "fonts": "node scripts/fetch-fonts.mjs",
    "eas-build-pre-install": "node scripts/fetch-fonts.mjs",
    "splash": "node scripts/generate-splash.mjs",
    "test": "vitest run",
    "test:web": "pnpm build:web && playwright test",
    "test:coverage": "vitest run --coverage",
    "doctor": "react-doctor",
    "doctor:gate": "node scripts/react-doctor-gate.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "postinstall": "node scripts/prepare-submodules.mjs",
    "build:player": "node scripts/prepare-submodules.mjs react-native-anything-player",
    "test:tooling": "node --test scripts/__tests__/*.test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/material-icons": "^14.0.0",
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "animu-api": "link:packages/animu-api",
    "expo": "~58.0.22",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-auth-session": "~58.0.16",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-media-library": "~58.0.13",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "fflate": "0.8.3",
    "html2canvas-pro": "~2.6.0",
    "kuromoji": "0.1.2",
    "react": "19.3.0",
    "react-freeze": "^1.0.4",
    "react-native": "0.88.1",
    "react-native-anything-player": "link:packages/react-native-anything-player",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.2.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0",
    "wanakana": "5.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-preset-expo": "~58.0.23",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-sonarjs": "^4.2.2",
    "expo-doctor": "^1.21.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "6.44.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "react-doctor": "^0.9.18",
    "react-dom": "19.3.0",
    "sherif": "1.13.0",
    "tar": "7.5.22",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": true,
        "exclude": [
          "@react-native-vector-icons/material-icons",
          "react-native-anything-player"
        ]
      }
    },
    "install": {
      "exclude": [
        "react-native-webview",
        "react-native-view-shot"
      ]
    }
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "patchedDependencies": {
      "react-native-drawer-layout@^4.2.11": "patches/react-native-drawer-layout@4.2.11.patch",
      "react-native-gesture-handler@3.3.0": "patches/react-native-gesture-handler@3.3.0.patch",
      "react-native-worklets@0.13.0": "patches/react-native-worklets@0.13.0.patch",
      "react-native-reanimated@4.7.1": "patches/react-native-reanimated@4.7.1.patch"
    }
  }
}
