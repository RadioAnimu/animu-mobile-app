// Release pipeline for the Animu Android app — fully local, no EAS.
//
// Produces the same artifact set as the manual GitHub releases:
//   animu-<version>-code<versionCode>.aab  (Play Store upload)
//   animu-<version>-code<versionCode>.apk  (universal direct-install)
// a SHA-256 checksum for each, and a RELEASE_NOTES.md with the artifact table,
// Play per-device download sizes (bundletool), and the checksums.
//
// Runs natively on the `animu-android-native` host agent (Node + JDK + Android
// SDK/NDK). The Gradle project directory is stable across runs, so rebuilds are
// incremental instead of starting from scratch.
//
// Signing uses the project's Android upload keystore, read from the
// `android-upload-keystore` credential and injected into the Gradle build the
// same way EAS does (an extra `signingConfigs.release` + `apply from`).
//
// Parameters
//   VERSION               Marketing version, e.g. 3.0.1 (must match app.json)
//   VERSION_CODE          Android versionCode, e.g. 16 (must match app.json)
//   TAG                   Git tag / release tag, e.g. v3.0.1
//   CREATE_GITHUB_RELEASE When true, create the GitHub release and upload assets
//   DRAFT                 Create the GitHub release as a draft
//   PRERELEASE            Mark the GitHub release as a pre-release

pipeline {
  agent { label 'animu-android-native' }

  parameters {
    string(name: 'VERSION', defaultValue: '', description: 'Marketing version (e.g. 3.0.1). Must match app.json.')
    string(name: 'VERSION_CODE', defaultValue: '', description: 'Android versionCode (e.g. 16). Must match app.json.')
    string(name: 'TAG', defaultValue: '', description: 'Git/release tag (e.g. v3.0.1).')
    booleanParam(name: 'CREATE_GITHUB_RELEASE', defaultValue: false, description: 'Create the GitHub release and upload the signed artifacts.')
    booleanParam(name: 'DRAFT', defaultValue: true, description: 'Create the GitHub release as a draft (only used when CREATE_GITHUB_RELEASE is true).')
    booleanParam(name: 'PRERELEASE', defaultValue: false, description: 'Mark the GitHub release as a pre-release (only used when CREATE_GITHUB_RELEASE is true).')
  }

  options {
    timestamps()
    timeout(time: 120, unit: 'MINUTES')
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
    skipDefaultCheckout(true)
  }

  environment {
    CI = 'true'
    EXPO_NO_TELEMETRY = '1'
    ARTIFACT_DIR = 'release-artifacts'
    // /tmp is a small tmpfs; point temp at the real disk.
    TMPDIR = '/home/rmotafreitas/jenkins-tmp'
    TMP = '/home/rmotafreitas/jenkins-tmp'
    // Persistent Gradle cache so rebuilds are incremental instead of cold.
    GRADLE_USER_HOME = "${WORKSPACE}/.gradle-home"
    // Give Gradle the whole machine and a real daemon heap.
    GRADLE_OPTS = '-Dorg.gradle.daemon=true -Dorg.gradle.parallel=true -Dorg.gradle.caching=true -Dorg.gradle.workers.max=12'
    ANDROID_HOME = '/home/rmotafreitas/Android/Sdk'
    ANDROID_SDK_ROOT = '/home/rmotafreitas/Android/Sdk'
    // Match the EAS SDK 57 Android toolchain (JDK 17, not the host's JDK 21).
    JAVA_HOME = '/home/rmotafreitas/.sdkman/candidates/java/17.0.20-tem'
  }

  stages {
    stage('Validate parameters') {
      steps {
        sh '''
          set -eux
          [ -n "$VERSION" ] || { echo "VERSION is required"; exit 1; }
          [ -n "$VERSION_CODE" ] || { echo "VERSION_CODE is required"; exit 1; }
          [ -n "$TAG" ] || { echo "TAG is required"; exit 1; }
          echo "Releasing VERSION=$VERSION VERSION_CODE=$VERSION_CODE TAG=$TAG"
        '''
      }
    }

    stage('Toolchain') {
      steps {
        sh '''
          set -eux
          java -version
          node --version
          npm --version
          gh --version
          echo "ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT"
          ls "$ANDROID_SDK_ROOT/ndk"
          ls "$ANDROID_SDK_ROOT/build-tools"
          nproc
        '''
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
        sh '''
          set -eux
          git submodule update --init --recursive
          test -d "$WORKSPACE/packages/animu-api" || { echo "animu-api submodule missing"; exit 1; }
        '''
      }
    }

    stage('Install') {
      steps {
        // The Proxima Nova fonts are licensed and gitignored. They are staged
        // on the host outside the repo and copied into the workspace here.
        withCredentials([string(credentialsId: 'android-upload-keystore', variable: 'ANDROID_UPLOAD_KEYSTORE_B64')]) {
          sh '''
            set -eux
            FONTS_STAGE="${FONTS_STAGE:-$HOME/.animu-secrets/fonts}"
            if [ -d "$FONTS_STAGE" ]; then
              mkdir -p src/assets/fonts
              cp "$FONTS_STAGE"/proximanova-reg.ttf "$FONTS_STAGE"/proximanova-bold.ttf src/assets/fonts/
            fi
            node scripts/fetch-fonts.mjs
            for f in proximanova-reg.ttf proximanova-bold.ttf; do
              test -f "src/assets/fonts/$f" || { echo "missing font: $f (stage it in $FONTS_STAGE)"; exit 1; }
            done
            npm ci --prefix packages/animu-api
            npm run build --prefix packages/animu-api
            npm ci

            # Decode the upload keystore once, into a workspace-local path the
            # Gradle signing injection reads. Removed after the build.
            mkdir -p "$WORKSPACE/.signing"
            echo "$ANDROID_UPLOAD_KEYSTORE_B64" | base64 -d > "$WORKSPACE/.signing.json"
            node -e '
              const fs = require("fs");
              const j = JSON.parse(fs.readFileSync(process.env.WORKSPACE + "/.signing.json", "utf8"));
              fs.writeFileSync(process.env.WORKSPACE + "/.signing/upload.jks", Buffer.from(j.keystore, "base64"));
            '
          '''
        }
      }
    }

    // Hard gate: never ship a release that fails the same checks as CI.
    stage('Pre-release checks') {
      steps {
        sh '''
          set -eux
          npx tsc --noEmit
          npx expo lint
          npm test
          score=$(npx react-doctor --score)
          echo "React Doctor score: $score"
          if [ "$score" -lt 85 ]; then
            echo "React Doctor score $score is below the required minimum of 85"
            exit 1
          fi
        '''
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: '**/junit*.xml'
        }
      }
    }

    stage('Verify app.json matches parameters') {
      steps {
        sh '''
          set -eux
          APP_VERSION=$(node -p "require('./app.json').expo.version")
          APP_CODE=$(node -p "require('./app.json').expo.android.versionCode")
          [ "$APP_VERSION" = "$VERSION" ] || {
            echo "app.json version ($APP_VERSION) != VERSION ($VERSION)"; exit 1; }
          [ "$APP_CODE" = "$VERSION_CODE" ] || {
            echo "app.json versionCode ($APP_CODE) != VERSION_CODE ($VERSION_CODE)"; exit 1; }
          echo "app.json matches VERSION=$VERSION VERSION_CODE=$VERSION_CODE"
        '''
      }
    }

    stage('Prebuild + inject signing') {
      steps {
        sh '''
          set -eux


          # Generate the native project from app.json + config plugins, same as
          # EAS did. Reuse an existing android/ when present so Gradle stays
          # incremental; regenerate only when missing or FORCE_PREBUILD=1.
          if [ ! -d android ] || [ "${FORCE_PREBUILD:-0}" = "1" ]; then
            npx expo prebuild --platform android --clean --no-install
          else
            echo "Reusing existing android/ (set FORCE_PREBUILD=1 to regenerate)"
          fi

          # Make sure node_modules match the generated project (patch-package
          # and the animu-api build run from the postinstall hook).
          npm install --no-audit --no-fund

          # Inject the release signing config the same way EAS does: a small
          # Gradle script that adds a `release` signingConfig and applies it.
          node scripts/inject-android-signing.mjs
        '''
      }
    }

    stage('Build signed AAB (production, Play upload)') {
      steps {
        sh '''
          set -eux

          mkdir -p "$ARTIFACT_DIR" "$GRADLE_USER_HOME" "$TMPDIR"
          cd android
          ./gradlew :app:bundleRelease --no-daemon
          cd ..
          cp android/app/build/outputs/bundle/release/app-release.aab \
             "$ARTIFACT_DIR/animu-${VERSION}-code${VERSION_CODE}.aab"
          ls -la "$ARTIFACT_DIR"
        '''
      }
    }

    // Derive the universal APK from the AAB with bundletool instead of running
    // a second Gradle build. Signing uses the same upload keystore, so the APK
    // carries the same signer as the AAB/Play and stays updatable.
    stage('Derive universal APK from AAB') {
      steps {
        sh '''
          set -eux
          AAB="$ARTIFACT_DIR/animu-${VERSION}-code${VERSION_CODE}.aab"
          APK="$ARTIFACT_DIR/animu-${VERSION}-code${VERSION_CODE}.apk"
          TOOLS="$WORKSPACE/.tools"
          BUNDLETOOL_VERSION=1.18.1
          BUNDLETOOL_JAR="$TOOLS/bundletool.jar"
          mkdir -p "$TOOLS" "$TMPDIR"

          if [ ! -f "$BUNDLETOOL_JAR" ]; then
            curl -fsSL -o "$BUNDLETOOL_JAR" \
              "https://github.com/google/bundletool/releases/download/${BUNDLETOOL_VERSION}/bundletool-all-${BUNDLETOOL_VERSION}.jar"
          fi

          APKS="$TMPDIR/universal.apks"
          rm -f "$APKS"
          KS="$WORKSPACE/.signing/upload.jks"
          SP=$(node -p "require(process.env.WORKSPACE + '/.signing.json').keystorePassword")
          KP=$(node -p "(require(process.env.WORKSPACE + '/.signing.json').keyPassword) || (require(process.env.WORKSPACE + '/.signing.json').keystorePassword)")
          ALIAS=$(node -p "require(process.env.WORKSPACE + '/.signing.json').keyAlias")

          java -jar "$BUNDLETOOL_JAR" build-apks \
            --bundle="$AAB" --output="$APKS" --mode=universal \
            --ks="$KS" --ks-pass="pass:$SP" --ks-key-alias="$ALIAS" --key-pass="pass:$KP"

          rm -rf "$TMPDIR/universal-extract"
          unzip -o -q "$APKS" -d "$TMPDIR/universal-extract"
          cp "$TMPDIR/universal-extract/universal.apk" "$APK"
          ls -la "$APK"
        '''
      }
    }

    stage('Validate signing certificates') {
      steps {
        sh '''
          set -eux
          AAB="$ARTIFACT_DIR/animu-${VERSION}-code${VERSION_CODE}.aab"
          APK="$ARTIFACT_DIR/animu-${VERSION}-code${VERSION_CODE}.apk"
          test -f "$AAB" || { echo "AAB missing: $AAB"; exit 1; }
          test -f "$APK" || { echo "APK missing: $APK"; exit 1; }

          # Play rejects AABs signed with the Android debug key. The AAB stores
          # its signature in META-INF; the universal APK uses the v2/v3 APK
          # Signature Scheme, so it must be checked with apksigner.
          AAB_CERT=$(unzip -p "$AAB" 'META-INF/*.RSA' 2>/dev/null | keytool -printcert 2>/dev/null || true)
          echo "--- AAB certificate ---"
          echo "$AAB_CERT"
          [ -n "$AAB_CERT" ] || { echo "ERROR: could not read AAB signature"; exit 1; }
          if echo "$AAB_CERT" | grep -q "CN=Android Debug"; then
            echo "ERROR: AAB is signed with the Android debug keystore"; exit 1
          fi

          APKSIGNER=$(find "$ANDROID_SDK_ROOT/build-tools" -name apksigner | sort | tail -1)
          echo "--- APK signing certificate ---"
          "$APKSIGNER" verify --print-certs "$APK" | tee "$TMPDIR/apk-certs.txt"
          if grep -q "CN=Android Debug" "$TMPDIR/apk-certs.txt"; then
            echo "ERROR: APK is signed with the Android debug keystore"; exit 1
          fi

          # The universal APK is derived from the AAB, so both must carry the
          # same signer. Compare SHA-256 fingerprints.
          AAB_SHA256=$(echo "$AAB_CERT" | grep -i "SHA256:" | head -1 | sed 's/.*SHA256: *//' | tr -d ':' | tr 'A-F' 'a-f')
          APK_SHA256=$("$APKSIGNER" verify --print-certs "$APK" \
            | grep -i "certificate SHA-256 digest" | head -1 | sed 's/.*digest: *//' | tr -d ':' | tr 'A-F' 'a-f')
          echo "AAB signer SHA-256: $AAB_SHA256"
          echo "APK signer SHA-256: $APK_SHA256"
          [ -n "$AAB_SHA256" ] && [ "$AAB_SHA256" = "$APK_SHA256" ] || {
            echo "ERROR: APK signer does not match the AAB signer"; exit 1; }
        '''
      }
    }

    stage('Checksums + bundletool sizes + release notes') {
      steps {
        sh '''
          set -eux
          cd "$ARTIFACT_DIR"
          AAB="animu-${VERSION}-code${VERSION_CODE}.aab"
          APK="animu-${VERSION}-code${VERSION_CODE}.apk"

          sha256sum "$AAB" > "$AAB.sha256"
          sha256sum "$APK" > "$APK.sha256"
          AAB_SHA=$(cut -d' ' -f1 "$AAB.sha256")
          APK_SHA=$(cut -d' ' -f1 "$APK.sha256")

          human() { awk -v s="$(stat -c%s "$1")" 'BEGIN{printf "%.1f MB", s/1048576}'; }
          AAB_SIZE=$(human "$AAB")
          APK_SIZE=$(human "$APK")

          # --- bundletool: per-device download sizes from the AAB ---
          BUNDLETOOL_VERSION=1.18.1
          TOOLS="$WORKSPACE/.tools"
          BUNDLETOOL_JAR="$TOOLS/bundletool.jar"
          KS="$WORKSPACE/.signing/upload.jks"
          SP=$(node -p "require(process.env.WORKSPACE + '/.signing.json').keystorePassword")
          KP=$(node -p "(require(process.env.WORKSPACE + '/.signing.json').keyPassword) || (require(process.env.WORKSPACE + '/.signing.json').keystorePassword)")
          ALIAS=$(node -p "require(process.env.WORKSPACE + '/.signing.json').keyAlias")

          APKS="$TMPDIR/animu-size.apks"
          rm -f "$APKS"
          java -jar "$BUNDLETOOL_JAR" build-apks \
            --bundle="$AAB" --output="$APKS" --mode=default \
            --ks="$KS" --ks-pass="pass:$SP" --ks-key-alias="$ALIAS" --key-pass="pass:$KP" >/dev/null

          # One device spec per line: abi|density|sdk. bundletool's get-size
          # total reports the min/max COMPRESSED download size for the matched
          # splits (what a device actually downloads from Play).
          SIZE_TABLE=""
          for spec in \
            "arm64-v8a|480|34" "armeabi-v7a|480|34" "x86_64|480|34" \
            "arm64-v8a|320|34" "arm64-v8a|640|34"; do
            abi=${spec%%|*}; rest=${spec#*|}; dpi=${rest%%|*}; sdk=${rest#*|}
            printf '{"supportedAbis":["%s"],"supportedLocales":["en-US"],"screenDensity":%s,"sdkVersion":%s}\n' \
              "$abi" "$dpi" "$sdk" > "$TMPDIR/dev.json"
            row=$(java -jar "$BUNDLETOOL_JAR" get-size total \
              --apks="$APKS" --device-spec="$TMPDIR/dev.json" 2>/dev/null \
              | awk -F, 'NR==2 {printf "%.1f MB", $1/1048576}')
            if [ -n "$row" ]; then
              SIZE_TABLE="${SIZE_TABLE}| ${abi} · ${dpi}dpi · SDK ${sdk} | ${row} |\n"
            fi
          done

          {
            echo "## Android release ${TAG} (versionCode ${VERSION_CODE})"
            echo ""
            echo "Built on Jenkins, signed with the Play upload key."
            echo ""
            echo "### Artifacts"
            echo "| File | Size | SHA-256 | Use |"
            echo "|---|---|---|---|"
            echo "| ${AAB} | ${AAB_SIZE} | ${AAB_SHA} | Play Store upload |"
            echo "| ${APK} | ${APK_SIZE} | ${APK_SHA} | Direct install (universal APK) |"
            echo ""
            if [ -n "$SIZE_TABLE" ]; then
              echo "### Play Store download size per device (bundletool ${BUNDLETOOL_VERSION})"
              echo "Compressed download size of the splits Play serves to the matched device."
              echo ""
              echo "| Device | Download |"
              echo "|---|---|"
              printf '%b' "$SIZE_TABLE"
            else
              echo "_(bundletool per-device sizes unavailable for this build)_"
            fi
          } > RELEASE_NOTES.md

          echo "=== RELEASE_NOTES.md ==="
          cat RELEASE_NOTES.md
        '''
      }
    }

    stage('GitHub release') {
      when { expression { return params.CREATE_GITHUB_RELEASE } }
      steps {
        withCredentials([string(credentialsId: 'github-release-token', variable: 'GH_TOKEN')]) {
          sh '''
            set -eux
            export GH_TOKEN
            cd "$ARTIFACT_DIR"
            AAB="animu-${VERSION}-code${VERSION_CODE}.aab"
            APK="animu-${VERSION}-code${VERSION_CODE}.apk"

            set -- --title "${TAG} (Android)" --target main --notes-file RELEASE_NOTES.md
            [ "$DRAFT" = "true" ] && set -- "$@" --draft
            [ "$PRERELEASE" = "true" ] && set -- "$@" --prerelease

            if gh release view "$TAG" >/dev/null 2>&1; then
              echo "Release $TAG already exists; uploading assets"
            else
              gh release create "$TAG" "$@"
            fi

            gh release upload "$TAG" "$AAB" "$APK" "$AAB.sha256" "$APK.sha256" RELEASE_NOTES.md --clobber
          '''
        }
      }
    }
  }

  post {
    always {
      sh '''
        # Never leave keystore material in the workspace.
        rm -rf "$WORKSPACE/.signing" "$WORKSPACE/.signing.json" \
               "$WORKSPACE/android/app/ci-signing.gradle" 2>/dev/null || true
        if [ -d "$ARTIFACT_DIR" ]; then ls -la "$ARTIFACT_DIR"; fi
      '''
      archiveArtifacts artifacts: 'release-artifacts/*', allowEmptyArchive: true, fingerprint: true
    }
    success { echo 'Release pipeline succeeded.' }
    failure { echo 'Release pipeline failed.' }
  }
}
