{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./*"]
    }
  },
  // Expo's base excludes, plus the Airwave submodule's own project (its tests,
  // example apps and scripts). Its sources the app imports are still checked.
  "exclude": [
    "${configDir}/coverage",
    "${configDir}/dist",
    "${configDir}/node_modules",
    "${configDir}/babel.config.js",
    "${configDir}/metro.config.js",
    "${configDir}/jest.config.js",
    "${configDir}/android",
    "${configDir}/ios",
    "${configDir}/packages/react-native-airwave"
  ]
}
