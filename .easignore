# EAS local-build ignore list.
#
# `eas build` uses `.easignore` when present (falling back to `.gitignore`).
# We deliberately do NOT re-list the licensed Proxima Nova fonts here: they are
# gitignored for the public repo, but the release pipeline stages them into
# src/assets/fonts/ before building, and the local build archive must include
# them so the `eas-build-pre-install` hook (scripts/fetch-fonts.mjs) finds them.

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native projects (generated by `expo prebuild`; store builds run via EAS)
ios/
android/

# Metro
.metro-health-check*

# Logs & debug output
logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
report.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed

# TypeScript / tooling caches
*.tsbuildinfo
.cache
.eslintcache
.npm

# Merge leftovers
*.orig.*

# Local env files — never commit
.env
.env.test
.env*.local

# Secrets & signing material
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
radioanimu-f57f5fb48b99.json

# macOS
.DS_Store

# AltStore distribution artifacts (host on your server, not in git)
altstore/*.ipa

# VS Code
.vscode/

# Release output produced by the Jenkins pipeline
release-artifacts/

# Persisted tool caches staged by the Jenkins release pipeline
.gradle-home/
.tools/
