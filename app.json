{
  "expo": {
    "name": "Rádio Animu",
    "version": "4.0.1",
    "slug": "animu",
    "orientation": "default",
    "icon": "./assets/icon-android.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#270052",
    "scheme": "animuapp",
    "ios": {
      "icon": "./assets/icon-ios.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.nessjs.animu",
      "appleTeamId": "RWDZC8478Q",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleSpokenName": "Animu",
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "Radio Animu"
          },
          {
            "INAlternativeAppName": "Animu"
          }
        ]
      },
      "buildNumber": "6"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android.png",
        "backgroundColor": "#270052"
      },
      "package": "com.nessjs.animu",
      "versionCode": 19,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "name": "Rádio Animu",
      "shortName": "Animu",
      "description": "A rádio mais moe do Brasil",
      "lang": "pt-BR",
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon-ios.png",
      "themeColor": "#270052",
      "backgroundColor": "#270052"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#270052",
          "image": "./assets/splash_top.png",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true,
          "android": {
            "drawable": {
              "icon": "./assets/splash-android-blank.xml"
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/proximanova-reg.ttf",
            "./src/assets/fonts/proximanova-bold.ttf"
          ]
        }
      ],
      "expo-asset",
      "expo-web-browser",
      ["react-native-anything-player", { "car": { "ios": false }, "catalog": "./rnap-catalog.json" }],
      "expo-apple-authentication",
      "expo-image",
      "@react-native-vector-icons/material-icons",
      "./plugins/withAndroidDeepLinkOnNewIntent",
      "./plugins/withIOSAppIntents",
      "./plugins/withIOSViewFilters",
      "expo-localization",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allows Rádio Animu to save your listening stats card to your photo library.",
          "isAccessMediaLocationEnabled": false,
          "photosPermission": false,
          "granularPermissions": []
        }
      ],
      "./plugins/withAndroidReleaseResources",
      "./plugins/withAndroidLargeScreenOrientation",
      "./plugins/withAndroidR8Optimization"
    ],
    "extra": {
      "eas": {
        "projectId": "506eccd6-2206-459c-b70b-5b79515d5b49"
      }
    }
  }
}
