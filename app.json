{
  "expo": {
    "name": "Rádio Animu",
    "version": "2.0.4",
    "slug": "animu",
    "orientation": "portrait",
    "icon": "./assets/icon_top.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash_top.png",
      "backgroundColor": "#270051"
    },
    "scheme": "animuapp",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nessjs.animu",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-top.png",
        "backgroundColor": "#270051"
      },
      "package": "com.nessjs.animu",
      "versionCode": 10,
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/proximanova-reg.ttf",
            "./src/assets/fonts/proximanova-bold.ttf"
          ]
        }
      ],
      "expo-asset",
      "expo-web-browser",
      ["expo-audio", { "recordAudioAndroid": false }],
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "506eccd6-2206-459c-b70b-5b79515d5b49"
      }
    }
  }
}
