{
  "expo": {
    "name": "Rádio Animu",
    "version": "3.0.0",
    "slug": "animu",
    "orientation": "portrait",
    "icon": "./assets/icon_top.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#270052",
    "scheme": "animuapp",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nessjs.animu",
      "appleTeamId": "RWDZC8478Q",
      "infoPlist": {
        "LSMinimumSystemVersion": "16.4",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleSpokenName": "Animu",
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "Radio Animu"
          },
          {
            "INAlternativeAppName": "Animu"
          }
        ]
      },
      "buildNumber": "6"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_top.png",
        "backgroundColor": "#270052"
      },
      "package": "com.nessjs.animu",
      "versionCode": 15,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#270052",
          "image": "./assets/splash_top.png",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true,
          "android": {
            "drawable": {
              "icon": "./assets/splash-android-blank.xml"
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/proximanova-reg.ttf",
            "./src/assets/fonts/proximanova-bold.ttf"
          ]
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-image",
      "@react-native-vector-icons/material-icons",
      "./plugins/withAndroidDeepLinkOnNewIntent",
      "./plugins/withIOSAppIntents",
      "./plugins/withAndroidAppActions",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allows Rádio Animu to save your listening stats card to your photo library.",
          "isAccessMediaLocationEnabled": false,
          "photosPermission": false,
          "granularPermissions": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "506eccd6-2206-459c-b70b-5b79515d5b49"
      }
    }
  }
}
